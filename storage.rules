rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Gallery photos — admin uploads, public read
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
