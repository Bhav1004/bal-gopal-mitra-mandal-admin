rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public read (all residents can read) ──────────────────────────────────
    match /updates/{doc} {
      allow read: if true;
      allow write: if request.auth != null;   // admin only
    }

    match /schedule/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /aartis/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gallery/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Feedback: anyone can submit, only admin can read ─────────────────────
    match /feedback/{doc} {
      allow create: if true;           // residents submit without login
      allow read, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── Device tokens: app writes on install, admin reads ────────────────────
    match /device_tokens/{doc} {
      allow create: if true;           // app stores token on first launch
      allow read, update, delete: if request.auth != null;
    }

    // ── Notification history: admin read/write only ───────────────────────────
    match /notification_history/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
